{
  "scripts": {
    "lint": "npm run lint:py && npm run lint:js",
    "lint:py": "python -m ruff check Aoede/concierge Aoede/downloader-worker",
    "lint:js": "eslint Aoede/assets/js",
    "format:check": "npm run format:py:check && npm run format:js:check",
    "format:py:check": "python -m ruff format --check Aoede/concierge Aoede/downloader-worker",
    "format:py": "python -m ruff format Aoede/concierge Aoede/downloader-worker",
    "format:js:check": "prettier --check Aoede/assets/js",
    "format:js": "prettier --write Aoede/assets/js",
    "test": "python -m pytest",
    "check": "bash scripts/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4"
  }
}
